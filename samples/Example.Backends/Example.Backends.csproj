<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\I18Next.Net\I18Next.Net.csproj" />
        <ProjectReference Include="..\..\src\I18Next.Net.Yaml\I18Next.Net.Yaml.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="yaml\**\*" CopyToOutputDirectory="PreserveNewest" />
        <None Update="remote\**\*" CopyToOutputDirectory="PreserveNewest" />
        <EmbeddedResource Include="Embedded\*.json" LogicalName="Locales.%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
