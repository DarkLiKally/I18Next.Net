<Window x:Class="Example.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="https://github.com/DarkLiKally/I18Next.Net"
        Title="{i18n:T title}" Width="440" Height="300">
    <StackPanel Margin="16">
        <ComboBox SelectedValue="{Binding Language}" SelectedValuePath="Tag" Width="140" HorizontalAlignment="Left">
            <ComboBoxItem Content="English" Tag="en" />
            <ComboBoxItem Content="Deutsch" Tag="de" />
        </ComboBox>

        <TextBlock Margin="0,16,0,0" FontSize="18" Text="{i18n:T greeting, Args={Binding Name}}" />
        <TextBox Margin="0,8,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Margin="0,16,0,0" Text="{i18n:T inbox, Count={Binding Count}}" />
        <Slider Margin="0,8,0,0" Minimum="0" Maximum="10" IsSnapToTickEnabled="True" Value="{Binding Count}" />

        <TextBlock Margin="0,16,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{i18n:T hint}" />
    </StackPanel>
</Window>
