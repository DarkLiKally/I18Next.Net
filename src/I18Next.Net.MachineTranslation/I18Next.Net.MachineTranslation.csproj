<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Machine translation for I18Next.Net with DeepL, Azure AI Translator or a delegate, keeping i18next placeholders, nesting and HTML intact.</Description>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
        <NoWarn>CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DocumentationFile>bin\Debug\I18Next.Net.MachineTranslation.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\I18Next.Net.MachineTranslation.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\I18Next.Net\I18Next.Net.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="I18Next.Net.MachineTranslation.Tests" />
    </ItemGroup>

</Project>
