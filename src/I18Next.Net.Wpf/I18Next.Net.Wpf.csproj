<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>WPF integration for I18Next.Net with a markup extension whose translations update when the language or the translation files change.</Description>
        <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
        <UseWPF>true</UseWPF>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
      <Compile Include="..\Shared\Xaml\*.cs" LinkBase="Shared" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\I18Next.Net\I18Next.Net.csproj" />
    </ItemGroup>

</Project>
