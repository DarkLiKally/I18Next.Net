<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Backend for I18Next.Net reading translations from compiled gettext .mo files.</Description>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\I18Next.Net.Abstractions\I18Next.Net.Abstractions.csproj" />
      <ProjectReference Include="..\I18Next.Net\I18Next.Net.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="NGettext" Version="0.6.7" />
    </ItemGroup>

</Project>
