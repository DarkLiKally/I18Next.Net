<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Godot 4 integration for I18Next.Net which resolves Tr(), TrN() and auto translated controls through i18next and loads the translations from the Godot file system.</Description>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IsAotCompatible>true</IsAotCompatible>
        <GodotDisabledSourceGenerators>ScriptPathAttribute;GodotPluginsInitializer</GodotDisabledSourceGenerators>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="GodotSharp" Version="4.3.0" />
      <PackageReference Include="Godot.SourceGenerators" Version="4.3.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\I18Next.Net\I18Next.Net.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="I18Next.Net.Godot.Tests" />
    </ItemGroup>

</Project>
