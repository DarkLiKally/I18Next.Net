<UserControl x:Class="I18Next.Net.Wpf.Tests.TranslatedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="https://github.com/DarkLiKally/I18Next.Net">
    <StackPanel>
        <TextBlock x:Name="TitleText" Text="{i18n:T menu.title}" />
        <TextBlock x:Name="ItemsText" Text="{i18n:T item, Args={Binding User}, Count={Binding Count}}" />
    </StackPanel>
</UserControl>
